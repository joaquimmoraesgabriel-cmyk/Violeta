.param amp_d=table(caso,0,0.004,1,0.004,2,0.004,3,0.004,4,0.004,5,0.004,6,0.004,7,0.004,8,0.004,9,0.004,10,0.004,11,0.004,12,0.004,13,0.004,14,0.004,15,0.004,16,0.01,17,0.01,18,0.01,19,0.01,20,0.01,21,0.01,22,0.01,23,0.01)
.param x_inicial=table(caso,0,-0.37,1,0.37,2,-0.37,3,0.37,4,-0.37,5,0.37,6,-0.37,7,0.37,8,-0.37,9,0.37,10,-0.37,11,0.37,12,-0.37,13,0.37,14,-0.37,15,0.37,16,-0.37,17,0.37,18,-0.37,19,0.37,20,-0.37,21,0.37,22,-0.37,23,0.37)
.param y_inicial=table(caso,0,-0.2,1,-0.2,2,-0.2,3,-0.2,4,-0.2,5,-0.2,6,-0.2,7,-0.2,8,-0.2,9,-0.2,10,-0.2,11,-0.2,12,-0.2,13,-0.2,14,-0.2,15,-0.2,16,-0.2,17,-0.2,18,-0.2,19,-0.2,20,-0.2,21,-0.2,22,-0.2,23,-0.2)
.param passo=table(caso,0,2.5e-06,1,2.5e-06,2,1.25e-06,3,1.25e-06,4,2.5e-06,5,2.5e-06,6,1.25e-06,7,1.25e-06,8,2.5e-06,9,2.5e-06,10,1.25e-06,11,1.25e-06,12,2.5e-06,13,2.5e-06,14,1.25e-06,15,1.25e-06,16,2.5e-06,17,2.5e-06,18,1.25e-06,19,1.25e-06,20,2.5e-06,21,2.5e-06,22,1.25e-06,23,1.25e-06)
.step param caso 0 23 1
.save V(x) V(saida) V(orcamento)
.tran 0 0.85 0 {passo} uic
.meas tran minimo_00 MIN V(x) FROM 0.030000 TO 0.049000
.meas tran maximo_00 MAX V(x) FROM 0.030000 TO 0.049000
.meas tran minimo_01 MIN V(x) FROM 0.080000 TO 0.099000
.meas tran maximo_01 MAX V(x) FROM 0.080000 TO 0.099000
