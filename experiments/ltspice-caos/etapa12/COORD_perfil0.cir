.meas tran maximo_16 MAX V(x) FROM 0.830000 TO 0.849000
.meas tran pico_orcamento MAX V(orcamento) FROM 0 TO 0.85
.meas tran pico_sem_protecao MAX V(sem_protecao) FROM 0 TO 0.85
.meas tran uso_protecao AVG V(guard_ativo) FROM 0 TO 0.85
.meas tran uso_reserva AVG V(reserva_ativa) FROM 0 TO 0.85
.meas tran sobra MAX V(sobra) FROM 0.03 TO 0.85
.meas tran falta MAX V(falta) FROM 0.03 TO 0.85
.end
